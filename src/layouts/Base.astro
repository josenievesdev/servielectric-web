---
import { empresa } from '../data/empresa';
import '../styles/global.css';
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{empresa.titular} | {empresa.nombre}</title>
    <meta name="description" content={empresa.descripcion} />
    <meta name="theme-color" content="#01177D" />
    <link rel="preload" href="/fonts/barlow-latin-700.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <slot />
  </body>
</html>
