---
interface Props {
  nombre: 'whatsapp' | 'ubicacion' | 'indicaciones' | 'flecha' | 'instagram' | 'linkedin';
}
const { nombre } = Astro.props;
---
<svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {nombre === 'whatsapp' && <>
    <path d="M20.5 11.7a8.5 8.5 0 0 1-12.7 7.4L3 20.5l1.4-4.7a8.5 8.5 0 1 1 16.1-4.1Z" />
    <path d="m8.2 7.2 1.5 2.5-.8 1.2c.8 1.5 1.7 2.4 3.2 3.2l1.2-.8 2.5 1.5c-.2 1.3-1 1.8-2.2 1.7-3.9-.4-7.3-3.8-7.7-7.7-.1-1.2.4-2 1.7-2.2Z" />
  </>}
  {nombre === 'ubicacion' && <>
    <path d="M20 10c0 6-8 11-8 11S4 16 4 10a8 8 0 1 1 16 0Z" />
    <circle cx="12" cy="10" r="2.5" />
  </>}
  {nombre === 'indicaciones' && <path d="m3 3 18 7-8 3-3 8L3 3Z" />}
  {nombre === 'flecha' && <path d="M5 12h14m-6-6 6 6-6 6" />}
  {nombre === 'instagram' && <>
    <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
    <circle cx="12" cy="12" r="4" />
    <circle cx="17.2" cy="6.8" r="0.6" fill="currentColor" />
  </>}
  {nombre === 'linkedin' && <>
    <rect x="3.5" y="3.5" width="17" height="17" rx="2.5" />
    <path d="M8 10.5V16M8 7.6v.1M11.5 16v-5.5m0 2.4c0-1.5 1-2.4 2.3-2.4s2.2.9 2.2 2.4V16" />
  </>}
</svg>
