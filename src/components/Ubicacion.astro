---
import { empresa, indicacionesUrl, mapaEmbedUrl } from '../data/empresa';
import { whatsappUrl } from '../lib/contacto';
import Icono from './Icono.astro';
---
<section id="ubicacion" class="section location" aria-labelledby="titulo-ubicacion" tabindex="-1">
  <div class="container location-layout">
    <div class="location-content">
      <Icono nombre="ubicacion" />
      <h2 id="titulo-ubicacion">Visítanos en Valledupar</h2>
      <address>{empresa.direccion}</address>
      <p class="contact-phone">WhatsApp <span>{empresa.telefonoVisible}</span></p>
      <div class="actions location-actions">
        <a class="button button-primary" href={indicacionesUrl}><Icono nombre="indicaciones" />Cómo llegar</a>
        <a class="button" href={whatsappUrl(empresa.mensajeCotizacion)}><Icono nombre="whatsapp" />Cotizar por WhatsApp</a>
      </div>
    </div>
    <div class="location-map">
      <iframe
        src={mapaEmbedUrl}
        title="Ubicación de Servielectric Ferreteria en Valledupar"
        width="640"
        height="480"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>
